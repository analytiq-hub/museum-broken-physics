{
  "name": "museum-broken-physics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "bench": "vitest run --config vitest.bench.config.ts --silent=false",
    "check": "tsc --noEmit && oxlint --deny-warnings && vitest run && vitest run --config vitest.bench.config.ts",
    "solve": "vitest run --config vitest.harness.config.ts --silent=false",
    "screenshots": "node harness/screenshots.ts",
    "ui-check": "node harness/ui-check.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.187.0",
    "oxlint": "^1.94.0",
    "playwright-core": "^1.65.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "lil-gui": "^0.21.0",
    "stats.js": "^0.17.0",
    "three": "^0.187.0"
  }
}
